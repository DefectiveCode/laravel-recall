{
  "name": "defectivecode/laravel-recall",
  "description": "High-performance Redis client-side caching for Laravel using APCu or Swoole Table with automatic cache invalidation",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "DefectiveCode\\Recall\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DefectiveCode\\Recall\\Tests\\": "tests"
    }
  },
  "authors": [
    {
      "name": "Corey McCormick",
      "email": "corey@defectivecode.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "illuminate/cache": "^12.0|^13.0",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "laravel/octane": "^2.26",
    "laravel/pint": "^1.32.3",
    "mockery/mockery": "^1.6.15",
    "nunomaduro/collision": "^8.9.6",
    "orchestra/testbench": "^10.12 || ^11.3",
    "phpstan/phpstan": "^2.3.7",
    "phpstan/phpstan-mockery": "^2.0",
    "phpunit/phpunit": "^12.5.45 || ^13.4.8",
    "predis/predis": "^3.8"
  },
  "suggest": {
    "ext-apcu": "Required for APCu local cache driver (default)",
    "ext-swoole": "Required for Swoole Table local cache driver",
    "laravel/octane": "Required for automatic cache warming on worker start"
  },
  "extra": {
    "laravel": {
      "providers": [
        "DefectiveCode\\Recall\\RecallServiceProvider"
      ]
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "test": "vendor/bin/phpunit",
    "lint": "vendor/bin/pint",
    "analyse": "vendor/bin/phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
